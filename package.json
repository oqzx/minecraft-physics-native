{
    "name": "minecraft-physics-native",
    "version": "1.0.0",
    "description": "Minecraft physics engine with version-aware physics behavior.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "napi": {
        "binaryName": "index",
        "targets": [
            "x86_64-pc-windows-msvc",
            "wasm32-wasip1-threads",
            "wasm32-wasip1"
        ],
        "wasm": {
            "initialMemory": 2048
        }
    },
    "scripts": {
        "lint": "eslint src --ext .ts,.tsx",
        "build": "tsc",
        "test": "tsc && node --test \"test/*.test.cjs\"",
        "native:build": "pnpm generate:block-registries && pnpm generate:block-states && pnpm generate:native-data && napi build --manifest-path native/Cargo.toml --release --platform --output-dir native/artifacts --js native.js --dts native.d.ts",
        "native:build:wasm": "pnpm generate:block-registries && pnpm generate:block-states && pnpm generate:native-data && napi build --manifest-path native/Cargo.toml --release --platform --target wasm32-wasip1-threads --output-dir native/artifacts --js native.js --dts native.d.ts",
        "native:build:wasip1": "pnpm generate:block-registries && pnpm generate:block-states && pnpm generate:native-data && napi build --manifest-path native/Cargo.toml --release --platform --target wasm32-wasip1 --output-dir native/artifacts --js native.js --dts native.d.ts",
        "generate:versions": "node scripts/generate-version-manifest.cjs",
        "generate:block-registries": "node scripts/generate-block-registry-manifest.cjs",
        "generate:block-states": "node scripts/generate-block-state-manifest.cjs",
        "generate:native-data": "node scripts/generate-native-data.cjs",
        "verify:version-coverage": "node scripts/verify-version-coverage.cjs",
        "extract:physics-methods": "node scripts/extract-physics-methods.cjs",
        "report:physics-breakpoints": "node scripts/report-physics-breakpoints.cjs",
        "compare:tick-traces": "node scripts/compare-tick-traces.cjs",
        "native:test": "pnpm native:build && node scripts/native-smoke.cjs",
        "native:verify-package": "pnpm native:build && node scripts/verify-native-package.cjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "@napi-rs/cli": "^3.9.0",
        "@nxg-org/mineflayer-physics-util": "1.9.10",
        "@types/node": "^22.20.1",
        "@typescript-eslint/eslint-plugin": "^8.27.0",
        "@typescript-eslint/parser": "^8.27.0",
        "emnapi": "2.0.0-alpha.6",
        "eslint": "^9.23.0",
        "globals": "^16.0.0",
        "minecraft-data": "^3.117.0",
        "mineflayer": "github:GenerelSchwerz/mineflayer#dev",
        "prismarine-block": "^1.23.0",
        "prismarine-registry": "^1.12.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.27.0",
        "vec3": "^0.2.0"
    },
    "dependencies": {
        "@emnapi/core": "2.0.0-alpha.6",
        "@emnapi/runtime": "2.0.0-alpha.6",
        "@napi-rs/wasm-runtime": "1.2.5"
    }
}
